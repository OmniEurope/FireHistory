{
  "name": "firehistory",
  "version": "0.1.0",
  "private": true,
  "description": "Firefox extension: searchable, filterable browsing history page",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "preview": "vite --config vite.dev.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "node tests/e2e/firefox.mjs"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
